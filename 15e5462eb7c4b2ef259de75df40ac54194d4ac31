      "writtenOn": "2018-03-05T09:59:08Z",
      "side": 1,
      "message": "Is multus independent/separate from calico?  Or are both required?",
      "range": {
        "startLine": 6,
        "startChar": 0,
        "endLine": 10,
        "endChar": 15
      },
      "revId": "15e5462eb7c4b2ef259de75df40ac54194d4ac31",
