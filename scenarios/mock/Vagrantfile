# mock scenario Vagrantfile

require 'yaml'
settings = YAML.load_file('config/mock/config.yml')#

Vagrant.configure("2") do |config|

  config.vm.box = "ubuntu/trusty64"

  # sync these folders with VM
  config.vm.synced_folder "../../", "/home/vagrant/cord/", create: true
  config.vm.synced_folder "./cord_profile", "/home/vagrant/cord_profile/", create: true

  # set the headnode VM
  config.vm.define "headnode" do |d|
    d.vm.network "private_network",
      ip: settings['head_vm_ip']
    d.vm.provider :virtualbox do |vb|
      vb.memory = settings['vm_memory']
    end
    h.vm.provider :libvirt do |v|
      v.memory = settings['vm_memory']
    end
  end

end

