{
	"name":"multus-cni-network",
		"type":"multus",
		"kubeconfig":"/etc/kubernetes/admin.conf",
		"delegates":[{
			"name":"multus-cni",
			"nodename":"{{ansible_hostname}}",
			"type":"calico",
			"etcd_endpoints":"{{etcd_access_addresses}}",
			"etcd_cert_file":"{{etcd_cert_dir}}/node-{{inventory_hostname}}.pem",
			"etcd_key_file":"{{etcd_cert_dir}}/node-{{inventory_hostname}}-key.pem",
			"etcd_ca_cert_file":"{{etcd_cert_dir}}/ca.pem",
			"log_level":"info",
			"ipam":{
				"type":"calico-ipam",
				"assign_ipv4":"true",
				"ipv4_pools":["{{kube_pods_subnet}}"]
			},
			{%ifenable_network_policy%}
			"policy":{
				"type":"k8s"
			},
				{%-endif%}
			{%ifcalico_mtuisdefinedandcalico_mtuisnumber%}
			"mtu":{{calico_mtu}},
				{%-endif%}
			"kubernetes":{
				"kubeconfig":"{{kube_config_dir}}/node-kubeconfig.yaml"
			},
				"masterplugin":true
		}
	]
}
